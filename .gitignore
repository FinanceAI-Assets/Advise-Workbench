*.log
*.tmp

# Editor and assistant tool folders (not needed to run the app)
.claude/
.cursor/
.vscode/
.idea/

# Tool caches
.ruff_cache/
.grimp_cache/
.import_linter_cache/
.mypy_cache/

# Logs and process ids written by scripts/run_agent.sh
.run/

# CI junit output
/reports/

