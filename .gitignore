# Python runtime
.venv/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc
.coverage
**/.coverage
*.egg-info/

# Legacy paths (kept for backwards compatibility with older clones)
advise_workbench.db
advise_workbench.db-shm
advise_workbench.db-wal
workspace/

# Frontend runtime/build
frontend/node_modules/
frontend/.next/
frontend/tsconfig.tsbuildinfo

